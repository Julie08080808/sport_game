# 此為環境變數範本,請複製為 .env 並填入實際值
APP_ENV=development
ENABLE_DEV_ADMIN=true

DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password

# 登入 session token 有效天數（/api/assistant/chat 等需要登入的 API）
SESSION_TTL_DAYS=30

# 阿明（AI 助手）Cloudflare Worker。網址固定，密鑰另外給，不要寫進程式碼或 git。
WORKER_URL=https://elder-assistant.lm-foodcam-ai.workers.dev/
WORKER_APP_SECRET=
WORKER_TIMEOUT_SECONDS=10

# 管理後台 /admin（需要登入）
# 開發環境（APP_ENV!=production 且 ENABLE_DEV_ADMIN=true）預設開啟；
# 正式 Server 要另外設 ENABLE_ADMIN_WEB=true。
# 下面三個值用 scripts/set_admin_password.py 產生，不要手打、不要放明文密碼。
ENABLE_ADMIN_WEB=false
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# 登入有效時數；伺服器改成 https 後把 ADMIN_COOKIE_SECURE 設成 true
ADMIN_SESSION_HOURS=12
ADMIN_COOKIE_SECURE=false

# 照護中心後台 /care（獨立於 /admin 的多帳號登入；帳號本身存在資料庫 caregiver_accounts，
# 由 /admin/care-centers 建立，不是放在這裡）。
# 開發環境（APP_ENV!=production 且 ENABLE_DEV_ADMIN=true）預設開啟；
# 正式 Server 要另外設 ENABLE_CARE_WEB=true。
ENABLE_CARE_WEB=false
# 至少 32 字元的隨機字串，用來簽 session cookie。
CARE_SESSION_SECRET=
CARE_SESSION_HOURS=12
