# 此為環境變數範本,請複製為 .env 並填入實際值
APP_ENV=development
ENABLE_DEV_ADMIN=true

DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password

# 登入 session token 有效天數（/api/assistant/chat 等需要登入的 API）
SESSION_TTL_DAYS=30

# 阿明（AI 助手）Cloudflare Worker。網址固定，密鑰另外給，不要寫進程式碼或 git。
WORKER_URL=https://elder-assistant.lm-foodcam-ai.workers.dev/
WORKER_APP_SECRET=
WORKER_TIMEOUT_SECONDS=10
